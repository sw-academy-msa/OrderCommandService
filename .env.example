# 실제 비밀번호·서비스 토큰은 .env에만 두고 커밋하지 않습니다.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8083
DB_URL=jdbc:postgresql://localhost:5434/order_command
DB_USERNAME=orders
DB_PASSWORD=replace-with-local-generated-secret
EUREKA_CLIENT_ENABLED=true
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
SERVICE_INSTANCE_ID=local-8083
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=stockdrop-api
ACCOUNT_JWKS_URI=http://localhost:8080/.well-known/jwks.json
ORDER_CLIENT_DISCOVERY_ENABLED=true
ORDER_ACCOUNT_ENABLED=true
ACCOUNT_INTERNAL_BASE_URL=http://localhost:8080
ORDER_PRODUCT_ENABLED=false
ORDER_PRODUCT_SERVICE_TOKEN=
PRODUCT_INTERNAL_BASE_URL=http://localhost:8081
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
ORDER_OUTBOX_PUBLISHER_ENABLED=false

ORDER_CHECKOUT_TERMS_VERSION=checkout-v1
ORDER_IMAGES_ENABLED=false
ORDER_IMAGES_BUCKET=
ORDER_IMAGES_LOCAL=false
ORDER_IMAGES_ENDPOINT=

# Account에서 서비스 JWT를 자동 획득·갱신합니다. 원문 비밀값은 Order만 보유합니다.
ORDER_SERVICE_AUTH_ENABLED=false
ORDER_SERVICE_CLIENT_ID=order-command-service
ORDER_SERVICE_CLIENT_SECRET=
ORDER_SERVICE_SUBJECT=

# 결제 요청/결과는 비공개 Kafka 토픽을 사용합니다.
ORDER_PAYMENT_EVENTS_ENABLED=false
ORDER_PAYMENT_CONSUMER_GROUP=order-command-payment-v1

# Account 탈퇴 내부 호출의 공개 주체 UUID입니다. 네 서비스에 같은 값을 설정합니다.
ACCOUNT_WITHDRAWAL_SUBJECT=

# Monitoring의 scripts/Initialize-LocalMonitoring.ps1에서 로컬 수집 토큰을 동기화합니다.
MONITORING_SCRAPE_TOKEN=
MONITORING_OUTBOX_ENABLED=false
